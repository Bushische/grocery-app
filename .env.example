# API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=/data/grocery.db
UPLOADS_PATH=/data/images
# Comma-separated allowlist (unset = reflect any origin, credentials allowed)
CORS_ORIGIN=http://localhost:5173

# OAuth provider for Alice account linking (T50) — client id/secret for the
# Yandex console "Account linking" tab. Generate a long random secret for prod:
#   openssl rand -base64 48
OAUTH_CLIENT_ID=alice
OAUTH_CLIENT_SECRET=change-me-to-a-long-random-string

# Alice webhook (T51) — skill id from https://dialogs.yandex.ru/developer/;
# requests with another session.skill_id are rejected with 403.
ALICE_SKILL_ID=change-me-to-the-yandex-skill-id

# Telegram Mini App (T59) — bot token from BotFather (@BotFather → /newbot).
# Powers initData signature validation; the stack boots without it outside
# production, but Telegram login only works with the real value.
# Generate nothing — paste the token BotFather gave you:
# TELEGRAM_BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw
# Freshness window for initData.auth_date (seconds, default 86400 = 24 h).
# TELEGRAM_AUTH_MAX_AGE_SECONDS=86400

# Web (dev proxy target)
API_URL=http://localhost:3000

# Cloudflare Tunnel (T22) — required to start the "tunnel" service:
#   docker compose --profile tunnel up -d
# Token from Cloudflare Zero Trust → Networks → Tunnels → <tunnel> → Install connector.
# In the same dashboard, add a public hostname:
#   https://grocery.<your-domain> → HTTP → web:8080
# (which is the equivalent of the DNS route <tunnel-id>.cfargotunnel.com).
# TUNNEL_TOKEN=
