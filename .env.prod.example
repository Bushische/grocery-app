# Production environment (T21). Copy to .env, adjust, then run
# ./scripts/build-images.sh and transfer with ./scripts/deploy.sh.
# On the NAS, docker compose -f docker-compose.prod.yml up -d.

# --- api (required) ---
NODE_ENV=production
JWT_SECRET=change-me-to-a-long-random-string
# DB + uploads live on named volumes, mounted at /data and /data/images in the container.
DATABASE_PATH=/data/grocery.db
UPLOADS_PATH=/data/images
# Comma-separated allowlist of browser origins allowed to call the API (credentials).
# REQUIRED in production: with an empty/unset value the api refuses to boot,
# because credentials:true + no allowlist would let any website call the API.
CORS_ORIGIN=https://grocery.example.com
# Log verbosity: fatal|error|warn|info|debug|trace|silent (default info).
LOG_LEVEL=info

# --- Alice integration (T49-T53) ---
# OAuth client for Yandex account linking + skill id from
# https://dialogs.yandex.ru/developer/ (see docs/ALICE_CONSOLE_SETUP.md).
# The stack boots without them (dev defaults in config.ts), but account linking
# only works with real values. The secret below must EXACTLY match the
# "Секрет приложения" value entered in the console "Связка аккаунтов" tab.
OAUTH_CLIENT_ID=alice
OAUTH_CLIENT_SECRET=generate-a-long-random-string-and-paste-it-also-into-the-console
ALICE_SKILL_ID=paste-the-yandex-skill-id-from-the-console

# --- Telegram Mini App (T59-T61) ---
# Bot token from BotFather. REQUIRED in production: the api refuses to boot
# without it (same fail-fast pattern as JWT_SECRET/CORS_ORIGIN).
TELEGRAM_BOT_TOKEN=paste-the-botfather-token-here
# Menu Button / /newapp URL = https://grocery.<your-domain>/ (this same web build).
# Freshness window for Mini App initData.auth_date (seconds, default 86400 = 24 h).
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Bot API chat (T62-T64): the bot hears "buy apples" via webhook.
# REQUIRED in production (fail-fast like the token above).
# Telegram allows only A-Z a-z 0-9 _ - (1-256 chars) in the secret — use hex,
# NOT base64 (base64 emits + / = which Telegram rejects with "illegal characters").
TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32-and-use-it-in-setWebhook-below
# Public Mini App URL for the open-app button in chat replies.
TELEGRAM_MINI_APP_URL=https://grocery.<your-domain>/
# Chat action extraction (T66): EXTRACTION_BACKEND=deterministic (default, no key
# needed) or jev (unstructured messages judged by TypeSafe JEV via OpenRouter —
# then OPENROUTER_API_KEY is REQUIRED, fail-fast like the token above).
EXTRACTION_BACKEND=deterministic
OPENROUTER_API_KEY=paste-the-openrouter-key-here-for-backend-jev
JEV_MODEL=typesafe/jev-1.13
JEV_TIMEOUT_MS=5000
JEV_CONFIDENCE_THRESHOLD=0.6

# --- web ---
WEB_PORT=8080
# Pin to date-tagged images for rollback-capable releases (see docs/DEPLOYMENT.md §11).
# Defaults in docker-compose.prod.yml are grocery-api:latest / grocery-web:latest.
# API_IMAGE=grocery-api:latest
# WEB_IMAGE=grocery-web:latest

# --- tunnel (T22, profile "tunnel") ---
# Required to start the tunnel service:
#   docker compose -f docker-compose.prod.yml --profile tunnel --env-file .env up -d
# Token from Cloudflare Zero Trust → Networks → Tunnels → <tunnel> → Install connector.
# In the same dashboard, add a public hostname:
#   https://grocery.<your-domain> → HTTP → web:8080
# (which is the equivalent of the DNS route <tunnel-id>.cfargotunnel.com),
# and set CORS_ORIGIN above to that https://grocery.<your-domain> origin.
TUNNEL_TOKEN=paste-the-cloudflare-tunnel-token-here
